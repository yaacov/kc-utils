# Copy to .env (gitignored) and edit:
#   cp tests/scenarios/.env.example tests/scenarios/.env

# vSphere (required)
GOVC_URL=vcsa.example.com
GOVC_USERNAME=administrator@vsphere.local
GOVC_PASSWORD=

# vSphere provider TLS: true = --provider-insecure-skip-tls; false = fetch CA from GOVC_URL:443
PROVIDER_INSECURE_SKIP_TLS=false

# Image FQIN for tests — written to MTV setting virt_v2v_image_fqin by benchmark scripts (not an MTV setting name)
KC_V2V_IMAGE=quay.io/you/kc-v2v:devel-amd64

# Optional: operator-default virt-v2v for compare/ref leg (inferred from controller deploy when unset)
# REF_V2V_IMAGE=quay.io/you/forklift-virt-v2v:devel-amd64

# Benchmark namespace and provider (required)
NS=mtv-kc-v2v-bench
PROVIDER=vsphere-test

# Optional: pin source VMs (auto-picked from mtv-func* inventory when unset)
# VM1=my-first-vm
# VM2=my-second-vm
# VM3=my-third-vm
