# kc-v2v — Forklift virt-v2v replacement (in-place conversion + NFC disk copy)
#
# Three-stage build:
#   1. builder     — compile Go binaries (official golang image)
#   2. downloader  — fetch guest conversion assets (no runtime bloat in final image)
#   3. runtime     — Fedora with only the tools and files we need
#
# Disk copy uses govmomi NFC export (pure Go, no VDDK required).
#
# Guest conversion assets (stage 2 → copied into runtime image):
#
#   /usr/share/virtio-win/
#   ├── drivers/by-os/<arch>/<os-version>/*.inf …   Windows virtio drivers
#   └── guest-agent/                                 qemu-ga MSI installers
#
#   /usr/share/kc-packages/
#   └── rpm/
#       ├── el8/x86_64/qemu-guest-agent-*.rpm        offline Linux QGA
#       ├── el9/x86_64/qemu-guest-agent-*.rpm
#       └── el10/x86_64/qemu-guest-agent-*.rpm

# ── Stage 1: Go build ────────────────────────────────────────────────
FROM docker.io/library/golang:1.24 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags '-s -w' -o /out/kc-prepare ./cmd/kc-prepare && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags '-s -w' -o /out/kc-finalize ./cmd/kc-finalize && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags '-s -w' -o /out/kc-convert-linux ./cmd/kc-convert-linux && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags '-s -w' -o /out/kc-convert-windows ./cmd/kc-convert-windows && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags '-s -w' -o /out/kc-v2v ./cmd/kc-v2v && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags '-s -w' -o /out/kc-copy ./cmd/kc-copy

# ── Stage 2: download guest conversion assets ────────────────────────
FROM quay.io/fedora/fedora:44 AS downloader

RUN dnf install -y --setopt=install_weak_deps=False curl bsdtar && dnf clean all

# virtio-win drivers from public Fedora People ISOs (modern + legacy).
# Override URLs at build time for version bumps or mirrors.
# Place ISOs in build/kc-v2v/cache/ to avoid re-downloading on each build.
ARG VIRTIO_WIN_MODERN_URL=https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/virtio-win-0.1.285-1/virtio-win-0.1.285.iso
ARG VIRTIO_WIN_LEGACY_URL=https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/virtio-win-0.1.160-1/virtio-win-0.1.160.iso
COPY build/kc-v2v/stage-virtio-win.sh /tmp/stage-virtio-win.sh
COPY build/kc-v2v/cache/ /tmp/virtio-win-cache/
RUN chmod +x /tmp/stage-virtio-win.sh && \
    VIRTIO_WIN_MODERN_URL="$VIRTIO_WIN_MODERN_URL" \
    VIRTIO_WIN_LEGACY_URL="$VIRTIO_WIN_LEGACY_URL" \
    VIRTIO_WIN_CACHE_DIR=/tmp/virtio-win-cache \
    /tmp/stage-virtio-win.sh && \
    rm -rf /tmp/stage-virtio-win.sh /tmp/virtio-win-cache

# Offline Linux qemu-guest-agent (RHEL family el8/el9/el10 x86_64)
COPY build/kc-v2v/stage-linux-packages.sh /tmp/stage-linux-packages.sh
RUN chmod +x /tmp/stage-linux-packages.sh && \
    /tmp/stage-linux-packages.sh /usr/share/kc-packages && \
    rm -f /tmp/stage-linux-packages.sh

# rhsrvany.exe — Windows service wrapper for firstboot (runs at boot without login).
RUN dnf install -y --setopt=install_weak_deps=False mingw-srvany-redistributable && \
    dnf clean all

# ── Stage 3: runtime ─────────────────────────────────────────────────
FROM quay.io/fedora/fedora:44

RUN dnf install -y --setopt=install_weak_deps=False \
        ca-certificates \
        qemu-img cryptsetup lvm2 clevis clevis-luks \
        hivex perl-hivex \
        libguestfs guestfs-tools libguestfs-xfs && \
    dnf clean all

COPY --from=downloader /usr/share/virtio-win/ /usr/share/virtio-win/
COPY --from=downloader /usr/share/kc-packages/ /usr/share/kc-packages/
COPY --from=downloader /usr/share/virt-tools/ /usr/share/virt-tools/

RUN mkdir -p /usr/lib/kc-utils
COPY --from=builder /out/kc-prepare /out/kc-finalize /out/kc-convert-linux /out/kc-convert-windows /out/kc-copy /usr/lib/kc-utils/
COPY --from=builder /out/kc-v2v /usr/bin/kc-v2v
COPY --from=builder /out/kc-copy /usr/bin/kc-copy

# Use the "direct" backend so libguestfs launches QEMU directly instead of
# routing through libvirtd (which is not available in a container). The pod
# only needs /dev/kvm. Guest FS access happens via guestfish RPC against
# mounts inside the appliance VM.
ENV LIBGUESTFS_BACKEND=direct
ENV V2V_backend=guestfs
# qemu uid 107 has passwd HOME=/; guestfish needs a writable $HOME/.guestfish.
ENV HOME=/var/tmp

ENTRYPOINT ["/usr/bin/kc-v2v"]
